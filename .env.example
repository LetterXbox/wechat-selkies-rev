WECHAT_IMAGE=ghcr.io/letterxbox/wechat-selkies-rev:latest
WECHAT_HOSTNAME=wechat-selkies
WECHAT_HTTP_PORT=3011
WECHAT_HTTPS_PORT=3012
PUID=1000
PGID=1000
TZ=Asia/Shanghai
LC_ALL=zh_CN.UTF-8

# Intel/AMD VA-API GPU node (leave unset to run software encoding)
DRINODE=/dev/dri/renderD128
DRI_NODE=/dev/dri/renderD128
DISABLE_DRI3=false

# Display backend: false = X11/DRI3 (recommended default), true = experimental Smithay/labwc Wayland
PIXELFLUX_WAYLAND=false

# Encoder policy: hardware VA-API first, no silent software JPEG fallback
SELKIES_ENCODER=h264enc,vp9enc,h265enc,vp8enc
SELKIES_RATE_CONTROL_MODE=crf,cbr
SELKIES_VIDEO_CRF=25

# Supervisor controls
AUTO_START_WECHAT=true
WECHAT_WINDOW_AUTOFIT=true
WECHAT_SHOW_TRAY=true
WECHAT_HEALTH_PORT=8090

# Optional built-in nginx Basic Auth (disabled when PASSWORD is empty; username defaults to abc)
# CUSTOM_USER=
# PASSWORD=

# Optional WeChat .deb overrides (defaults come from /etc/wechat-selkies/wechat.json)
# WECHAT_DEB_URL=
# WECHAT_DEB_SHA256=
# WECHAT_ALLOW_UNVERIFIED_LATEST=false

# Optional D-Bus desktop notification webhook bridge (disabled when empty)
# WECHAT_NOTIFY_WEBHOOK_URL=
# WECHAT_NOTIFY_REDACT_BODY=true

# Optional Tailscale sidecar overrides (used with compose.tailscale.yml)
# TS_AUTHKEY=
# TS_HOSTNAME=wechat

# Optional WebRTC overrides (used with compose.webrtc.yml)
# SELKIES_WEBRTC_PUBLIC_IP=
# SELKIES_STUN_HOST=stun.l.google.com
# SELKIES_STUN_PORT=19302
# SELKIES_TURN_HOST=
# SELKIES_TURN_PORT=3478
# SELKIES_TURN_PROTOCOL=udp
# SELKIES_TURN_TLS=false
# SELKIES_TURN_SHARED_SECRET=
