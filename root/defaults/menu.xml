<?xml version="1.0" encoding="utf-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="WeChat">
    <item label="Start / Focus WeChat">
      <action name="Execute">
        <command>/usr/local/bin/wechat-supervisor fit-window</command>
      </action>
    </item>
    <item label="Restart WeChat">
      <action name="Execute">
        <command>/usr/local/bin/wechat-supervisor restart</command>
      </action>
    </item>
    <separator />
    <item label="Reconfigure Openbox">
      <action name="Reconfigure" />
    </item>
  </menu>
</openbox_menu>
