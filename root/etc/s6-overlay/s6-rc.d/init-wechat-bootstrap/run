#!/usr/bin/with-contenv bash
set -euo pipefail

mkdir -p "${WECHAT_CACHE_DIR:-/config/.wechat-cache}" /var/lib/wechat-selkies
chown abc:abc "${WECHAT_CACHE_DIR:-/config/.wechat-cache}"

/usr/local/bin/wechat-supervisor bootstrap
chown -R abc:abc "${WECHAT_CACHE_DIR:-/config/.wechat-cache}"

# Migrate legacy Openbox configs from earlier images or older WeChat Selkies volumes.
OB_DIR="/config/.config/openbox"
if [ -d "${OB_DIR}" ]; then
  if [ ! -f "${OB_DIR}/autostart" ] || ! grep -q "wechat-supervisor" "${OB_DIR}/autostart"; then
    cp /defaults/autostart "${OB_DIR}/autostart"
    chmod 0755 "${OB_DIR}/autostart"
    chown abc:abc "${OB_DIR}/autostart"
  fi
  if [ ! -f "${OB_DIR}/menu.xml" ] || grep -q "/scripts/" "${OB_DIR}/menu.xml"; then
    cp /defaults/menu.xml "${OB_DIR}/menu.xml"
    chmod 0644 "${OB_DIR}/menu.xml"
    chown abc:abc "${OB_DIR}/menu.xml"
  fi
  if [ -f "${OB_DIR}/rc.xml" ]; then
    sed -i \
      -e '/<dock>/,/<\/dock>/s/<position>[^<]*<\/position>/<position>BottomRight<\/position>/' \
      -e '/<dock>/,/<\/dock>/s/<noStrut>no<\/noStrut>/<noStrut>yes<\/noStrut>/' \
      "${OB_DIR}/rc.xml"
    chown abc:abc "${OB_DIR}/rc.xml"
  fi
fi
